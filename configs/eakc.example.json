{
  "socket_path": "/run/eak/eakd.sock",
  "max_parallel": 4,
  "queue_size": 64,
  "actions": {
    "activate-terminal": {
      "type": "exec",
      "command": ["konsole"]
    },
    "activate-browser": {
      "type": "exec",
      "command": ["firefox"]
    },
    "activate-editor": {
      "type": "exec",
      "command": ["emacs"]
    },
    "activate-fileman": {
      "type": "exec",
      "command": ["dolphin"]
    },
    "activate-steam": {
      "type": "exec",
      "command": ["steam"]
    },
    "activate-terminal-special": {
      "type": "shell",
      "script": "notify-send 'EAK' 'special terminal action'"
    },
    "tile-1": {
      "type": "exec",
      "command": ["kwin-tile", "1"]
    },
    "tile-2": {
      "type": "exec",
      "command": ["kwin-tile", "2"]
    },
    "tile-3": {
      "type": "exec",
      "command": ["kwin-tile", "3"]
    },
    "tile-4": {
      "type": "exec",
      "command": ["kwin-tile", "4"]
    },
    "tile-5": {
      "type": "exec",
      "command": ["kwin-tile", "5"]
    },
    "tile-0": {
      "type": "exec",
      "command": ["kwin-tile", "0"]
    }
  }
}
