{
  "candidate_timeout": "750ms",
  "sequence_timeout": "750ms",
  "socket_path": "/run/eak/eakd.sock",
  "allowed_uids": [1000],
  "remaps": [
    {"keys": ["LOGO", "HOME"], "tap": "INSERT"},
    {"keys": ["LOGO", "END"], "tap": "DELETE"}
  ],
  "prefixes": [
    {
      "keys": ["LOGO", "A"],
      "bindings": [
        {"keys": ["T"], "action": "activate-terminal"},
        {"keys": ["B"], "action": "activate-browser"},
        {"keys": ["E"], "action": "activate-editor"},
        {"keys": ["F"], "action": "activate-fileman"},
        {"keys": ["S"], "action": "activate-steam"},
        {"keys": ["SHIFT", "T"], "action": "activate-terminal-special"}
      ]
    },
    {
      "keys": ["LOGO", "T"],
      "bindings": [
        {"keys": ["1"], "action": "tile-1"},
        {"keys": ["2"], "action": "tile-2"},
        {"keys": ["3"], "action": "tile-3"},
        {"keys": ["4"], "action": "tile-4"},
        {"keys": ["5"], "action": "tile-5"},
        {"keys": ["0"], "action": "tile-0"}
      ]
    }
  ]
}
